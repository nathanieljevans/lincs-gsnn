rule make_bio_network:
    ''''''
    output:
        net = os.path.join(BIO_NET_DIR, f"bionetwork.pt"),
        cell_drug_split = SPLIT_PATH,
        # gene_norm.pt: produced whenever cfg['make_bio_network']['gene_stats']
        # resolves to a valid path (required by BIOGSNN).
        gene_norm = GENE_NORM_PATH,
        # node_activity.pt is only declared as an output when the user has
        # enabled it; otherwise Snakemake does not expect it.
        **({"node_activity": NA_PATH} if USE_NA else {}),
    params:
        script = SCRIPTS["make_bio_network"],
        data = cfg['dirs']["data"],
        extdata = EXTDATA,
        meta = cfg['dirs']["preds"],
        out = BIO_NET_DIR,
        include_tf_mirna = _flag('include_tf_mirna', cfg['make_bio_network'].get("include_tf_mirna", False)),
        include_pathway_extra = _flag('include_pathway_extra', cfg['make_bio_network'].get("include_pathway_extra", False)),
        include_kinase_extra = _flag('include_kinase_extra', cfg['make_bio_network'].get("include_kinase_extra", False)),
        include_ligrec_extra = _flag('include_ligrec_extra', cfg['make_bio_network'].get("include_ligrec_extra", False)),
        include_collecTRI = _flag('include_collecTRI', cfg['make_bio_network'].get("include_collecTRI", False)),
        include_dorothea = _flag('include_dorothea', cfg['make_bio_network'].get("include_dorothea", False)),
        include_omnipath = _flag('include_omnipath', cfg['make_bio_network'].get("include_omnipath", False)),
        dorothea_levels = cfg['make_bio_network']["dorothea_levels"],
        complex_handling = cfg['make_bio_network'].get("complex_handling", 'link'),
        bio_filter_args = _bio_filter_args(),
        max_dti_kd = cfg['make_bio_network']["max_dti_kd"],
        filter_depth = cfg['make_bio_network']["filter_depth"],
        remove_output_edges = _flag('remove_output_edges', cfg['make_bio_network'].get("remove_output_edges", False)),
        n_edges_to_remove = cfg['make_bio_network']["n_edges_to_remove"],
        seed = cfg['make_bio_network']["seed"],
        val_cells_per_drug = cfg['make_bio_network'].get("val_cells_per_drug", 1),
        no_cell_line_edges = _flag('no_cell_line_edges', cfg['make_bio_network'].get("no_cell_line_edges", False)),
        include_gene_inputs = _flag('include_gene_inputs', cfg['make_bio_network'].get("include_gene_inputs", False)),
        no_uniprot_synonyms = _flag('no_uniprot_synonyms', cfg['make_bio_network'].get("no_uniprot_synonyms", False)),
        gene_stats = cfg['make_bio_network']["gene_stats"],
        cond_info = cfg['make_bio_network'].get(
            "cond_info",
            os.path.join(
                os.path.dirname(cfg['make_bio_network']["gene_stats"]),
                "cond_info.csv",
            ),
        ),
        node_activity_args = _na_make_bio_network_args(),
        simplify_args = _simplify_function_graph_args(),

    shell:
        """
        python {params.script} \
            --data {params.data} \
            --out  {params.out} \
            --extdata {params.extdata} \
            --meta {params.meta} \
            {params.include_tf_mirna} \
            {params.include_pathway_extra} \
            {params.include_kinase_extra} \
            {params.include_ligrec_extra} \
            {params.include_collecTRI} \
            {params.include_dorothea} \
            {params.include_omnipath} \
            --dorothea_levels {params.dorothea_levels} \
            --complex_handling {params.complex_handling} \
            {params.bio_filter_args} \
            --max_dti_kd {params.max_dti_kd} \
            --filter_depth {params.filter_depth} \
            {params.remove_output_edges} \
            --n_edges_to_remove {params.n_edges_to_remove} \
            --seed {params.seed} \
            --val_cells_per_drug {params.val_cells_per_drug} \
            {params.no_cell_line_edges} \
            {params.include_gene_inputs} \
            {params.no_uniprot_synonyms} \
            --gene_stats_path {params.gene_stats} \
            --cond_info_path {params.cond_info} \
            {params.node_activity_args} \
            {params.simplify_args}
        """

rule pretrain_gsnn:
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        split = SPLIT_PATH,
        # gene_norm artifact: unconditional input for BIOGSNN.
        gene_norm = GENE_NORM_PATH,
        # node_activity artifact is only declared as an input when enabled,
        # so the legacy DAG is unchanged.
        **({"node_activity": NA_PATH} if USE_NA else {}),
        obs_npy = os.path.join(cfg['dirs']["preds"], "obs.npy"),
        dxdt_npy = os.path.join(cfg['dirs']["preds"], "dxdt.npy"),
        dxdt_meta = os.path.join(cfg['dirs']["preds"], "dxdt_meta.csv"),
        gene_names = os.path.join(cfg['dirs']["preds"], "gene_names.csv"),
    output:
        # The legacy artifact is always produced; in hypernetwork mode it is
        # the "mean cell line" GSNN materialized from the trained hnet.
        model = os.path.join(PRETRAIN_DIR, "pretrained_model_{model}.pt"),
        scale = os.path.join(PRETRAIN_DIR, "dxdt_scale_{model}.pt"),
        val_metrics = os.path.join(PRETRAIN_DIR, "val_metrics_pretrain_{model}.json"),
        # The hnet artifact is only declared as an output when the user has
        # enabled hypernetwork training; otherwise it is omitted so Snakemake
        # does not expect it.
        **({"hnet": os.path.join(PRETRAIN_DIR, "pretrained_hnet_{model}.pt")} if USE_HNET else {}),
    params:
        script = SCRIPTS["pretrain"],
        data = cfg['dirs']['preds'],
        out = PRETRAIN_DIR,
        batch_size = cfg['pretrain']["batch_size"],
        num_workers = cfg['pretrain']["num_workers"],
        epochs = cfg['pretrain']["epochs"],
        lr = cfg['pretrain']["lr"],
        wd = cfg['pretrain']["wd"],
        init = cfg['pretrain']["init"],
        patience = cfg['pretrain']["patience"],
        channels = cfg['pretrain']["channels"],
        layers = cfg['pretrain']["layers"],
        share_layers = _flag('share_layers', cfg['pretrain'].get("share_layers", False)),
        dropout = cfg['pretrain']["dropout"],
        norm = cfg['pretrain']["norm"],
        checkpoint = _flag('checkpoint', cfg['pretrain'].get("checkpoint", False)),
        add_function_self_edges = _bool_opt('add_function_self_edges', cfg['pretrain'].get("add_function_self_edges", True)),
        bias                    = _bool_opt('bias', cfg['pretrain'].get("bias", True)),
        residual                = _bool_opt('residual', cfg['pretrain'].get("residual", True)),
        node_mlp                = _bool_opt('node_mlp', cfg['pretrain'].get("node_mlp", True)),
        node_mlp_dim            = cfg['pretrain'].get("node_mlp_dim", 128),
        node_attn               = _bool_opt('node_attn', cfg['pretrain'].get("node_attn", False)),
        attn_mlp_hidden         = cfg['pretrain'].get("attn_mlp_hidden", 32),
        model                   = _model_flag(cfg['pretrain'].get("model", 'GSNN')),
        objective               = cfg['pretrain'].get("objective", "nll"),
        clip_grad_norm          = cfg['pretrain'].get("clip_grad_norm", 0.0),
        dxdt_nonlin_arg         = (f"--dxdt_nonlin {cfg['pretrain']['dxdt_nonlin']}"
                                   if cfg['pretrain'].get("dxdt_nonlin") else ""),
        dxdt_clip_arg           = (f"--dxdt_clip {float(cfg['pretrain']['dxdt_clip'])}"
                                   if cfg['pretrain'].get("dxdt_clip") else ""),
        gamma_prior_args        = _gamma_prior_pretrain_args(),
        hnet_args               = _hnet_train_args(),
        node_activity_args      = _na_pretrain_args(),
        pretrain_train_args     = _pretrain_train_args(PRETRAIN_CFG),
        sigma_floor = _section_sigma_floor(PRETRAIN_CFG),
        model_seed = lambda w: _model_seed(w.model),

    shell:
        """
        python {params.script} \
            --data {params.data} \
            --out {params.out} \
            --bionet $(dirname {input.bionet}) \
            --gene_norm_path {input.gene_norm} \
            --split_path {input.split} \
            --model_id {wildcards.model} \
            --seed {params.model_seed} \
            --sigma_floor {params.sigma_floor} \
            --batch_size {params.batch_size} \
            --num_workers {params.num_workers} \
            --epochs {params.epochs} \
            --lr {params.lr} \
            --wd {params.wd} \
            --init {params.init} \
            --patience {params.patience} \
            --channels {params.channels} \
            --layers {params.layers} \
            {params.share_layers} \
            --dropout {params.dropout} \
            --norm {params.norm} \
            {params.checkpoint} \
            {params.add_function_self_edges} \
            {params.bias} \
            {params.residual} \
            {params.node_mlp} \
            --node_mlp_dim {params.node_mlp_dim} \
            {params.node_attn} \
            --attn_mlp_hidden {params.attn_mlp_hidden} \
            {params.model} \
            --objective {params.objective} \
            --clip_grad_norm {params.clip_grad_norm} \
            {params.dxdt_nonlin_arg} \
            {params.dxdt_clip_arg} \
            {params.gamma_prior_args} \
            {params.hnet_args} \
            {params.node_activity_args} \
            {params.pretrain_train_args}
        """


rule train_gsnn:
    """Optional odeint fine-tune of the pretrained GSNN against observed
    trajectories. Only included in the DAG when `train.enabled=true`; downstream
    explain rules then consume `trained_model_{model}.pt` via _model_artifact()."""
    input:
        bionet      = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        split       = SPLIT_PATH,
        gene_norm   = GENE_NORM_PATH,
        pretrained  = os.path.join(PRETRAIN_DIR, "pretrained_model_{model}.pt"),
        scale       = os.path.join(PRETRAIN_DIR, "dxdt_scale_{model}.pt"),
        obs_npy = os.path.join(cfg['dirs']["preds"], "obs.npy"),
        pred_meta = os.path.join(cfg['dirs']["preds"], "pred_meta.csv"),
        gene_names = os.path.join(cfg['dirs']["preds"], "gene_names.csv"),
        # node_activity artifact: required only when enabled, so the legacy
        # DAG stays unchanged.
        **({"node_activity": NA_PATH} if USE_NA else {}),
    output:
        model = os.path.join(TRAIN_DIR, "trained_model_{model}.pt"),
        val_metrics = os.path.join(TRAIN_DIR, "val_metrics_train_{model}.json"),
    params:
        script             = SCRIPTS["train"],
        data               = cfg['dirs']['preds'],
        out                = TRAIN_DIR,
        train_args         = _train_args(),
        sigma_floor        = _section_sigma_floor(TRAIN_CFG),
        model_seed         = lambda w: _model_seed(w.model),
        # Reuse the pretrain node_activity CLI helper: ODEFunc.set_x_fn needs
        # the same per-cell lookup, and the unused hidden/temperature/dropout
        # flags are accepted (and ignored) by the train script for CLI parity.
        node_activity_args = _na_pretrain_args(),
    shell:
        """
        python {params.script} \
            --data {params.data} \
            --out  {params.out} \
            --bionet $(dirname {input.bionet}) \
            --gene_norm_path {input.gene_norm} \
            --split_path {input.split} \
            --pretrained_model {input.pretrained} \
            --pretrained_scale {input.scale} \
            --model_id {wildcards.model} \
            --seed {params.model_seed} \
            --sigma_floor {params.sigma_floor} \
            {params.train_args} \
            {params.node_activity_args}
        """


def _ex(w):
    return EXAMPLES_BY_OUTPUT_DIR[w.output_dir]

rule contrastive_explanation:
    '''Contrastive explanation for one (output_dir, sample) pair.'''
    wildcard_constraints:
        output_dir = r"contrastive_explanation_[^/]+",
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        # Switches between pretrained_model and trained_model based on
        # train.enabled; see _model_artifact() for the gating logic.
        model  = lambda w: _model_artifact(w.model),
        scale  = os.path.join(PRETRAIN_DIR, "dxdt_scale_{model}.pt"),
        # Add the hnet artifact as a required input only in hypernetwork mode.
        **({"hnet": os.path.join(PRETRAIN_DIR, "pretrained_hnet_{model}.pt")} if (USE_HNET and HNET_USE_EXP) else {}),
        # Same for the node_activity artifact: required only when enabled.
        **({"node_activity": NA_PATH} if USE_NA else {}),
    output:
        csv = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "{model}",
                           "contrastive_results_{model}.csv"),
        pt  = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "{model}",
                           "contrastive_results_{model}.pt"),
    params:
        script             = SCRIPTS["contrastive_explanation"],
        root_gsnn          = os.path.join(cfg['dirs']['runs'], RUN_ID),
        root_traj          = cfg['dirs']["preds"].replace('/predict_grid', ''),
        out_dir            = lambda w: os.path.join(CONTRASTIVE_ROOT, w.output_dir, w.model),
        target_gene        = lambda w: _ex(w)["target_gene"],
        cell_line_1        = lambda w: _ex(w)["cell_line_1"],
        cell_line_2        = lambda w: _ex(w)["cell_line_2"],
        pert_id            = lambda w: _ex(w)["pert_id"],
        dose               = lambda w: _ex(w)["dose"],
        horizon            = lambda w: _ex(w)["horizon"],
        n_time_pts         = lambda w: _ex(w)["n_time_pts"],
        method             = lambda w: _ex(w)["method"],
        tol                = lambda w: _ex(w)["tol"],
        hard               = lambda w: _ex(w)["hard"],
        beta               = lambda w: _ex(w)["beta"],
        lr                 = lambda w: _ex(w)["lr"],
        prior              = lambda w: _ex(w)["prior"],
        iters              = lambda w: _ex(w)["iters"],
        entropy            = lambda w: _ex(w)["entropy"],
        grad_norm_clip     = lambda w: _ex(w)["grad_norm_clip"],
        free_edges         = lambda w: _ex(w)["free_edges"],
        explanation_target = lambda w: _ex(w)["explanation_target"],
        hnet_flag          = _hnet_explain_arg(),
        node_activity_args = _na_explain_args(),
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --root_gsnn {params.root_gsnn} \
            --root_traj {params.root_traj} \
            --model_id {wildcards.model} \
            --model_path {input.model} \
            --target_gene {params.target_gene} \
            --cell_line_1 {params.cell_line_1} \
            --cell_line_2 {params.cell_line_2} \
            --pert_id {params.pert_id} \
            --dose {params.dose} \
            --horizon {params.horizon} \
            --n_time_pts {params.n_time_pts} \
            --method {params.method} \
            --tol {params.tol} \
            {params.hard} \
            --beta {params.beta} \
            --lr {params.lr} \
            --prior {params.prior} \
            --iters {params.iters} \
            --entropy {params.entropy} \
            --grad_norm_clip {params.grad_norm_clip} \
            --free_edges {params.free_edges} \
            --explanation_target {params.explanation_target} \
            --out {params.out_dir} \
            {params.hnet_flag} \
            {params.node_activity_args}
        """

rule aggregate_contrastive:
    '''Aggregate per-sample contrastive results for one example.'''
    wildcard_constraints:
        output_dir = r"contrastive_explanation_[^/]+",
    input:
        csvs = lambda w: expand(
            os.path.join(CONTRASTIVE_ROOT, w.output_dir, "{model}",
                         "contrastive_results_{model}.csv"), model=MODELS),
        pts  = lambda w: expand(
            os.path.join(CONTRASTIVE_ROOT, w.output_dir, "{model}",
                         "contrastive_results_{model}.pt"),  model=MODELS),
    output:
        cres_csv = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "aggregated_cres.csv"),
        out_dict = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "aggregated_out_dict.pt"),
    params:
        script    = SCRIPTS["aggregate_contrastive"],
        input_dir = lambda w: os.path.join(CONTRASTIVE_ROOT, w.output_dir),
        out_dir   = lambda w: os.path.join(CONTRASTIVE_ROOT, w.output_dir),
        name      = "aggregated",
    shell:
        """
        python {params.script} \
            --input_dir {params.input_dir} \
            --out {params.out_dir} \
            --name {params.name}
        """

# ------------------------------------------------------------------------------------
# Non-contrastive explanation rules
# ------------------------------------------------------------------------------------

def _nc(w):
    return NC_EXAMPLES_BY_OUTPUT_DIR[w.output_dir]

rule non_contrastive_explanation:
    '''Non-contrastive explanation for one (output_dir, sample) pair.

    output_dir encodes both the parent contrastive example and a single
    cell line (e.g. ``non_contrastive_explanation_trametinib_mapk__MDAMB231``).
    All hyperparameters are inherited from the parent contrastive entry.
    '''
    wildcard_constraints:
        output_dir = r"non_contrastive_explanation_[^/]+",
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        # Switches between pretrained_model and trained_model based on
        # train.enabled; see _model_artifact() for the gating logic.
        model  = lambda w: _model_artifact(w.model),
        scale  = os.path.join(PRETRAIN_DIR, "dxdt_scale_{model}.pt"),
        **({"hnet": os.path.join(PRETRAIN_DIR, "pretrained_hnet_{model}.pt")} if (USE_HNET and HNET_USE_EXP) else {}),
        # Same gating as `contrastive_explanation`: only required when
        # node_activity is enabled.  In legacy mode (USE_NA=False) this
        # entry is omitted and the rule's input set is byte-identical to
        # the pre-node-activity workflow.
        **({"node_activity": NA_PATH} if USE_NA else {}),
    output:
        csv = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "{model}",
                           "non_contrastive_results_{model}.csv"),
        pt  = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "{model}",
                           "non_contrastive_results_{model}.pt"),
    params:
        script             = SCRIPTS["non_contrastive_explanation"],
        root_gsnn          = os.path.join(cfg['dirs']['runs'], RUN_ID),
        root_traj          = cfg['dirs']["preds"].replace('/predict_grid', ''),
        out_dir            = lambda w: os.path.join(CONTRASTIVE_ROOT, w.output_dir, w.model),
        target_gene        = lambda w: _nc(w)["target_gene"],
        cell_line          = lambda w: _nc(w)["cell_line"],
        pert_id            = lambda w: _nc(w)["pert_id"],
        dose               = lambda w: _nc(w)["dose"],
        horizon            = lambda w: _nc(w)["horizon"],
        n_time_pts         = lambda w: _nc(w)["n_time_pts"],
        method             = lambda w: _nc(w)["method"],
        tol                = lambda w: _nc(w)["tol"],
        hard               = lambda w: _nc(w)["hard"],
        beta               = lambda w: _nc(w)["beta"],
        lr                 = lambda w: _nc(w)["lr"],
        prior              = lambda w: _nc(w)["prior"],
        iters              = lambda w: _nc(w)["iters"],
        entropy            = lambda w: _nc(w)["entropy"],
        grad_norm_clip     = lambda w: _nc(w)["grad_norm_clip"],
        free_edges         = lambda w: _nc(w)["free_edges"],
        explanation_target = lambda w: _nc(w)["explanation_target"],
        hnet_flag          = _hnet_explain_arg(),
        node_activity_args = _na_explain_args(),
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --root_gsnn {params.root_gsnn} \
            --root_traj {params.root_traj} \
            --model_id {wildcards.model} \
            --model_path {input.model} \
            --target_gene {params.target_gene} \
            --cell_line {params.cell_line} \
            --pert_id {params.pert_id} \
            --dose {params.dose} \
            --horizon {params.horizon} \
            --n_time_pts {params.n_time_pts} \
            --method {params.method} \
            --tol {params.tol} \
            {params.hard} \
            --beta {params.beta} \
            --lr {params.lr} \
            --prior {params.prior} \
            --iters {params.iters} \
            --entropy {params.entropy} \
            --grad_norm_clip {params.grad_norm_clip} \
            --free_edges {params.free_edges} \
            --explanation_target {params.explanation_target} \
            --out {params.out_dir} \
            {params.hnet_flag} \
            {params.node_activity_args}
        """

rule aggregate_non_contrastive:
    '''Aggregate per-sample non-contrastive results for one (example, cell_line) pair.'''
    wildcard_constraints:
        output_dir = r"non_contrastive_explanation_[^/]+",
    input:
        csvs = lambda w: expand(
            os.path.join(CONTRASTIVE_ROOT, w.output_dir, "{model}",
                         "non_contrastive_results_{model}.csv"), model=MODELS),
        pts  = lambda w: expand(
            os.path.join(CONTRASTIVE_ROOT, w.output_dir, "{model}",
                         "non_contrastive_results_{model}.pt"),  model=MODELS),
    output:
        cres_csv = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "aggregated_cres.csv"),
        out_dict = os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "aggregated_out_dict.pt"),
    params:
        script    = SCRIPTS["aggregate_contrastive"],
        input_dir = lambda w: os.path.join(CONTRASTIVE_ROOT, w.output_dir),
        out_dir   = lambda w: os.path.join(CONTRASTIVE_ROOT, w.output_dir),
        name      = "aggregated",
    shell:
        """
        python {params.script} \
            --input_dir {params.input_dir} \
            --out {params.out_dir} \
            --name {params.name} \
            --results_prefix non_contrastive_results
        """

# ------------------------------------------------------------------------------------
# Explanation evaluation
# ------------------------------------------------------------------------------------

rule eval_explanation:
    '''Evaluate explanation quality and training metrics for one example.'''
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        contrastive_csv = lambda w: os.path.join(
            CONTRASTIVE_ROOT, EXAMPLES[w.example]["output_dir"], "aggregated_cres.csv"),
        contrastive_pt = lambda w: os.path.join(
            CONTRASTIVE_ROOT, EXAMPLES[w.example]["output_dir"], "aggregated_out_dict.pt"),
        nc1_csv = lambda w: os.path.join(
            CONTRASTIVE_ROOT,
            _nc_dir_for_example(EXAMPLES[w.example]["output_dir"], EXAMPLES[w.example]["cell_line_1"]),
            "aggregated_cres.csv"),
        nc2_csv = lambda w: os.path.join(
            CONTRASTIVE_ROOT,
            _nc_dir_for_example(EXAMPLES[w.example]["output_dir"], EXAMPLES[w.example]["cell_line_2"]),
            "aggregated_cres.csv"),
        pretrain_metrics = expand(
            os.path.join(PRETRAIN_DIR, "val_metrics_pretrain_{model}.json"), model=MODELS),
        train_metrics = (
            expand(os.path.join(TRAIN_DIR, "val_metrics_train_{model}.json"), model=MODELS)
            if USE_TRAIN else []),
    output:
        pt = os.path.join(EVAL_DIR, "{example}.pt"),
        json = os.path.join(EVAL_DIR, "{example}.json"),
    params:
        script = SCRIPTS["eval"],
        root_gsnn = CONTRASTIVE_ROOT,
        root_traj = ROOT_TRAJ,
        out_dir = EVAL_DIR,
        config_path = CONFIG_PATH,
        output_dir = lambda w: EXAMPLES[w.example]["output_dir"],
        explanation_target = lambda w: EXAMPLES[w.example]["explanation_target"],
        target_gene = lambda w: EXAMPLES[w.example]["target_gene"],
        pert_id = lambda w: EXAMPLES[w.example]["pert_id"],
        cell_line_1 = lambda w: EXAMPLES[w.example]["cell_line_1"],
        cell_line_2 = lambda w: EXAMPLES[w.example]["cell_line_2"],
        pretrain_dir = PRETRAIN_DIR,
        train_dir = TRAIN_DIR,
        use_train_flag = "--use_train" if USE_TRAIN else "",
        eval_spec_json = lambda w: json.dumps(EXAMPLES[w.example]["eval"]),
        model_id = MODELS[0] if MODELS else "model_0",
    shell:
        """
        python {params.script} \
            --root_gsnn {params.root_gsnn} \
            --root_traj {params.root_traj} \
            --example {wildcards.example} \
            --output_dir {params.output_dir} \
            --explanation_target {params.explanation_target} \
            --target_gene {params.target_gene} \
            --pert_id {params.pert_id} \
            --cell_line_1 {params.cell_line_1} \
            --cell_line_2 {params.cell_line_2} \
            --out_dir {params.out_dir} \
            --config_path {params.config_path} \
            --eval_spec_json '{params.eval_spec_json}' \
            --pretrain_dir {params.pretrain_dir} \
            --train_dir {params.train_dir} \
            {params.use_train_flag} \
            --model_id {params.model_id}
        """

rule aggregate_eval:
    '''Merge per-example eval artifacts into one run-level dict and wide CSV.'''
    input:
        expand(os.path.join(EVAL_DIR, "{example}.pt"), example=EVAL_EXAMPLES),
    output:
        pt = os.path.join(EVAL_DIR, "eval_results.pt"),
        json = os.path.join(EVAL_DIR, "eval_results.json"),
        csv = os.path.join(EVAL_DIR, "eval_results.csv"),
        config = os.path.join(EVAL_DIR, "config.yaml"),
    params:
        script = SCRIPTS["aggregate_eval"],
        eval_dir = EVAL_DIR,
        config_path = CONFIG_PATH,
        examples = ",".join(EVAL_EXAMPLES),
    shell:
        """
        python {params.script} \
            --eval_dir {params.eval_dir} \
            --config_path {params.config_path} \
            --examples {params.examples} \
            --out_name eval_results
        """