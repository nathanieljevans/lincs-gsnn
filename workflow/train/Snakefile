configfile: os.path.join(workflow.basedir, "config.yaml")
cfg = config

RUN_ID  = cfg["run_id"]
N_MODELS = int(cfg.get("n_models", 1))
BASE_SEED = int(cfg.get("base_seed", 0))
SIGMA_FLOOR = float(cfg.get("sigma_floor", 1e-4))


def _section_sigma_floor(section_cfg):
    """Per-section sigma_floor with fallback to the top-level default.

    Lets `pretrain:` and `train:` each set their own `sigma_floor` (e.g. to
    re-tune the NLL variance floor for the train rule without re-running
    pretrain). Falls back to the top-level `sigma_floor` when unset."""
    val = (section_cfg or {}).get("sigma_floor")
    return float(val) if val is not None else SIGMA_FLOOR

# Per-run Snakemake metadata (.snakemake/, locks, logs) lives under the run
# output tree so parallel invocations with different run_id values do not
# contend on workflow/train/.snakemake/. Override via snakemake_workdir in
# config when needed.
_sm_workdir = (cfg.get("snakemake_workdir") or "").strip()
SNAKEMAKE_WORKDIR = _sm_workdir if _sm_workdir else os.path.join(cfg["dirs"]["runs"], RUN_ID, ".snakemake")
workdir: SNAKEMAKE_WORKDIR
print(f"Snakemake workdir: {SNAKEMAKE_WORKDIR}")


def _snake_rel(path):
    """Resolve config paths relative to this Snakefile, not the run workdir."""
    if not path:
        return path
    if os.path.isabs(path):
        return path
    return os.path.normpath(os.path.join(workflow.basedir, path))


def _as_bool(v):
    if isinstance(v, bool):
        return v
    if v is None:
        return False
    s = str(v).strip().lower()
    if s in ('true', '1', 'yes'):
        return True
    if s in ('false', '0', 'no', ''):
        return False
    return bool(s)


def _flag(name, v):
    return f'--{name}' if _as_bool(v) else ''


def _bool_opt(name, v):
    return f'--{name}' if _as_bool(v) else f'--no-{name}'


def _model_flag(v):
    return '--BIOGSNN' if str(v).upper().endswith('BIOGSNN') else '--GSNN'


def _pretrain_train_args(section_cfg):
    """Render optimizer/amp/tf32/resume flags shared by pretrain and train rules."""
    parts = [
        f"--optimizer {section_cfg.get('optimizer', 'adamw')}",
    ]
    if _as_bool(section_cfg.get('amp')):
        parts.append('--amp')
    if _as_bool(section_cfg.get('grad_scaler')):
        parts.append('--grad_scaler')
    if _as_bool(section_cfg.get('torch32')):
        parts.append('--tf32')
    if _as_bool(section_cfg.get('resume_incomplete')):
        parts.append('--resume_incomplete')
    return ' '.join(parts)


SCRIPTS = {k: _snake_rel(v) for k, v in cfg["scripts"].items()}
EXTDATA = _snake_rel(cfg["dirs"]["extdata"])

BIO_NET_DIR      = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['dirs']["bio_network"])
PRETRAIN_DIR     = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['dirs']["pretrain"])
CONTRASTIVE_ROOT = os.path.join(cfg['dirs']['runs'], RUN_ID)

EXAMPLES               = cfg.get("contrastive_explanations", {})
EXAMPLES_BY_OUTPUT_DIR = {v["output_dir"]: v for v in EXAMPLES.values()}
OUTPUT_DIRS            = list(EXAMPLES_BY_OUTPUT_DIR.keys())

# ----------------------------------------------------------------------------
# Optional cell-line-conditioned hypernetwork. When `hypernetwork.enabled` is
# False (default), every shell command below is byte-identical to the legacy
# pipeline (i.e. no extra flags are passed and no extra artifacts are
# produced).
# ----------------------------------------------------------------------------
HNET_CFG     = cfg.get("hypernetwork", {}) or {}
USE_HNET     = bool(HNET_CFG.get("enabled", False))
HNET_USE_EXP = bool(HNET_CFG.get("use_in_explanation", True))

# ----------------------------------------------------------------------------
# Optional per-function-node activity conditioning. Same pattern as
# `hypernetwork`: when `node_activity.enabled` is False every shell command
# is byte-identical to the legacy pipeline and `node_activity.pt` is not
# produced. Mutually exclusive with the hypernetwork (the two mechanisms
# both inject cell-line information via different code paths).
# ----------------------------------------------------------------------------
NA_CFG     = cfg.get("node_activity", {}) or {}
USE_NA     = bool(NA_CFG.get("enabled", False))
NA_PATH    = NA_CFG.get("path", "") or os.path.join(BIO_NET_DIR, "node_activity.pt")

# ----------------------------------------------------------------------------
# Per-gene control-population mu/sigma artifact, copied from lincs-traj's
# gene_stats.dict into <bio_network>/gene_norm.pt by make_bio_network.py.
# BIOGSNN requires this artifact for its log1p-back degradation term, so it is
# unconditionally an input of every train rule and of `rule all`. The producer
# rule is gated only on the `make_bio_network.gene_stats` config entry (a
# missing entry will surface a friendly KeyError at Snakefile evaluation).
# ----------------------------------------------------------------------------
GENE_NORM_PATH = os.path.join(BIO_NET_DIR, "gene_norm.pt")
SPLIT_PATH = os.path.join(BIO_NET_DIR, "cell_drug_split.csv")

if USE_NA and USE_HNET:
    raise ValueError(
        "config.yaml: node_activity.enabled and hypernetwork.enabled are mutually "
        "exclusive (both inject cell-line conditioning into the GSNN). "
        "Disable one before running the workflow."
    )

# ----------------------------------------------------------------------------
# Optional odeint fine-tune of the pretrained GSNN against observed
# trajectories. When `train.enabled` is False (default), the workflow DAG and
# every shell command rendered below are byte-identical to the pre-train-rule
# pipeline. When True, a new `train_gsnn` rule runs after `pretrain_gsnn` and
# downstream explain rules consume `trained_model_{model}.pt` instead of
# `pretrained_model_{model}.pt`.
# ----------------------------------------------------------------------------
TRAIN_CFG = cfg.get("train", {}) or {}
USE_TRAIN = bool(TRAIN_CFG.get("enabled", False))
TRAIN_DIR = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['dirs'].get("train", "train"))
PRETRAIN_CFG = cfg.get("pretrain", {}) or {}

if USE_TRAIN and USE_HNET:
    raise ValueError(
        "config.yaml: train.enabled and hypernetwork.enabled are mutually "
        "exclusive in v1 (the odeint fine-tune does not support hypernetwork-"
        "conditioned models). Disable one before running the workflow."
    )


def _hnet_train_args():
    """Render --hnet_* CLI flags from cfg['hypernetwork']. Returns the empty
    string when hypernetwork is disabled so the shell command stays
    byte-identical to the legacy invocation."""
    if not USE_HNET:
        return ""
    parts = ["--use_hypernetwork"]
    parts.append(f"--hnet_stochastic_channels {int(HNET_CFG.get('stochastic_channels', 4))}")
    parts.append(f"--hnet_width {int(HNET_CFG.get('width', 8))}")
    parts.append(f"--hnet_pz {HNET_CFG.get('pz', 'normal')}")
    if bool(HNET_CFG.get("learn_pz", False)):
        parts.append("--hnet_learn_pz")
    if bool(HNET_CFG.get("affine", False)):
        parts.append("--hnet_affine")
    parts.append(f"--hnet_norm {HNET_CFG.get('norm', 'none')}")
    parts.append(f"--hnet_dropout {float(HNET_CFG.get('dropout', 0.0))}")
    if bool(HNET_CFG.get("bias", False)):
        parts.append("--hnet_bias")
    parts.append(f"--hnet_embed_dim {int(HNET_CFG.get('embed_dim', 0))}")
    parts.append(f"--hnet_n_train_samples {int(HNET_CFG.get('n_train_samples', 1))}")
    parts.append(f"--hnet_loss {HNET_CFG.get('loss', 'mse')}")
    if bool(HNET_CFG.get("pretrain_init", False)):
        parts.append("--hnet_pretrain_init")
    return " ".join(parts)


def _hnet_explain_arg():
    """Render the --use_hypernetwork flag for explanation rules, gated on
    BOTH `enabled` and `use_in_explanation`."""
    return "--use_hypernetwork" if (USE_HNET and HNET_USE_EXP) else ""


def _bio_filter_args():
    """Render optional --min_n_references / --min_curation_effort flags for
    make_bio_network. Returns the empty string when both are unset."""
    mbn = cfg.get("make_bio_network", {}) or {}
    parts = []
    min_refs = mbn.get("min_n_references")
    if min_refs is not None:
        parts.append(f"--min_n_references {int(min_refs)}")
    min_curation = mbn.get("min_curation_effort")
    if min_curation is not None:
        parts.append(f"--min_curation_effort {int(min_curation)}")
    return " ".join(parts)


def _na_make_bio_network_args():
    """Render the --node_activity[_eps|_features] flags for make_bio_network.
    Returns the empty string when node_activity is disabled so the legacy
    bionetwork artifact is byte-identical to today."""
    if not USE_NA:
        return ""
    parts = ["--node_activity"]
    parts.append(f"--node_activity_eps {float(NA_CFG.get('eps', 1e-6))}")
    feats = NA_CFG.get("features", ["expr"]) or ["expr"]
    if isinstance(feats, str):
        feats = [feats]
    parts.append("--node_activity_features " + " ".join(str(f) for f in feats))
    return " ".join(parts)


def _simplify_function_graph_args():
    """Render function-layer simplification flags for make_bio_network.
    Returns the empty string when disabled (legacy bionetwork artifact unchanged)."""
    mbn = cfg.get("make_bio_network", {}) or {}
    fgs = mbn.get("function_graph_simplify", {}) or {}
    if not fgs.get("enabled", False):
        return ""
    parts = []
    d1 = fgs.get("degree_one", {}) or {}
    if d1.get("enabled", False):
        parts.append("--simplify_degree_one")
        parts.append(f"--simplify_degree_one_in_degree {int(d1.get('in_degree', 1))}")
        parts.append(f"--simplify_degree_one_out_degree {int(d1.get('out_degree', 1))}")
    if fgs.get("check_reachability", False):
        parts.append("--simplify_check_reachability")
    return " ".join(parts)


def _na_pretrain_args():
    """Render the --node_activity[_*] flags for pretrain_gsnn. Empty when
    node_activity is disabled."""
    if not USE_NA:
        return ""
    parts = ["--node_activity"]
    parts.append(f"--node_activity_path {NA_PATH}")
    parts.append(f"--node_activity_hidden {int(NA_CFG.get('hidden_dim', 16))}")
    parts.append(f"--node_activity_temperature {float(NA_CFG.get('temperature', 1.0))}")
    parts.append(f"--node_activity_transform {NA_CFG.get('transform', 'sigmoid')}")
    parts.append(f"--node_activity_mass {float(NA_CFG.get('mass', 1.0))}")
    parts.append(f"--node_activity_dropout {float(NA_CFG.get('dropout', 0.0))}")
    parts.append(f"--node_activity_mode {NA_CFG.get('mode', 'per-node')}")
    # Train-time sparsity penalty on NodeActivity gate activations. Only
    # rendered in node_activity mode so the legacy CLI stays byte-identical.
    parts.append(f"--alpha_decay {float(NA_CFG.get('alpha_decay', 1e-2))}")
    return " ".join(parts)


def _gamma_prior_pretrain_args():
    """Render BIOGSNN gamma-init / prior flags for pretrain_gsnn. Empty when
    neither init_rna_half_life nor gamma_prior_weight is set in config."""
    parts = []
    if PRETRAIN_CFG.get("init_rna_half_life") is not None:
        parts.append(f"--init_rna_half_life {float(PRETRAIN_CFG['init_rna_half_life'])}")
    if PRETRAIN_CFG.get("gamma_prior_weight") is not None:
        parts.append(f"--gamma_prior_weight {float(PRETRAIN_CFG['gamma_prior_weight'])}")
    return " ".join(parts)


def _na_explain_args():
    """Render the --node_activity_path flag for explanation rules. Empty
    when node_activity is disabled (the explanation scripts auto-detect via
    model.node_activity, so the flag is only needed to override the default
    path)."""
    if not USE_NA:
        return ""
    return f"--node_activity_path {NA_PATH}"


def _train_args():
    """Render --epochs/--lr/... flags for the train_gsnn rule. Empty when
    train is disabled (the rule is also gated out of the DAG in that case)."""
    if not USE_TRAIN:
        return ""
    parts = [
        f"--epochs {int(TRAIN_CFG.get('epochs', 25))}",
        f"--lr {float(TRAIN_CFG.get('lr', 1e-3))}",
        f"--wd {float(TRAIN_CFG.get('wd', 1e-6))}",
        f"--patience {int(TRAIN_CFG.get('patience', 3))}",
        f"--batch_size {int(TRAIN_CFG.get('batch_size', 32))}",
        f"--num_workers {int(TRAIN_CFG.get('num_workers', 4))}",
        f"--horizon {int(TRAIN_CFG.get('horizon', 24))}",
        f"--method {TRAIN_CFG.get('method', 'euler')}",
        f"--tol {float(TRAIN_CFG.get('tol', 1e-4))}",
        f"--objective {TRAIN_CFG.get('objective', 'nll')}",
        f"--clip_grad_norm {float(TRAIN_CFG.get('clip_grad_norm', 0.0))}",
    ]
    if _as_bool(TRAIN_CFG.get("adjoint")):
        parts.append("--adjoint")
    if _as_bool(TRAIN_CFG.get("multiple_shooting")):
        parts.append("--multiple_shooting")
    if TRAIN_CFG.get("gamma_prior_weight") is not None:
        parts.append(f"--gamma_prior_weight {float(TRAIN_CFG['gamma_prior_weight'])}")
    parts.append(_pretrain_train_args(TRAIN_CFG))
    return " ".join(parts)


def _model_seed(model_wildcard):
    """Map model_k wildcard to replicate RNG seed."""
    idx = int(str(model_wildcard).split("_", 1)[1])
    return BASE_SEED + idx


def _model_artifact(model):
    """Return the on-disk path of the model artifact downstream explain rules
    should consume for a given model wildcard. When train.enabled=true, this
    is the odeint-fine-tuned model produced by rule train_gsnn; otherwise it
    is the pretrained model produced by rule pretrain_gsnn."""
    if USE_TRAIN:
        return os.path.join(TRAIN_DIR, f"trained_model_{model}.pt")
    return os.path.join(PRETRAIN_DIR, f"pretrained_model_{model}.pt")

# Derive non-contrastive (example x cell_line) outputs from each contrastive
# example. For each contrastive entry we produce two non-contrastive folders,
# one per cell_line_1 / cell_line_2. Folder name:
#   non_contrastive_explanation_<base>__<cell_line>/
# where <base> is the contrastive output_dir with the leading
# "contrastive_explanation_" stripped.
NC_EXAMPLES_BY_OUTPUT_DIR = {}
for _ex_key, _ex_cfg in EXAMPLES.items():
    _base = _ex_cfg["output_dir"].replace(
        "contrastive_explanation_", "non_contrastive_explanation_", 1)
    for _cell_field in ("cell_line_1", "cell_line_2"):
        _cell = _ex_cfg[_cell_field]
        _nc_dir = f"{_base}__{_cell}"
        NC_EXAMPLES_BY_OUTPUT_DIR[_nc_dir] = {**_ex_cfg, "cell_line": _cell}
NC_OUTPUT_DIRS = list(NC_EXAMPLES_BY_OUTPUT_DIR.keys())

# Examples with an optional ``eval:`` block (rule eval_explanation).
EVAL_EXAMPLES = [k for k, v in EXAMPLES.items() if v.get("eval")]
EVAL_DIR = os.path.join(CONTRASTIVE_ROOT, "eval")
ROOT_TRAJ = cfg['dirs']["preds"].replace('/predict_grid', '')
CONFIG_PATH = (
    workflow.configfiles[0]
    if getattr(workflow, "configfiles", None)
    else os.path.join(workflow.basedir, "config.yaml")
)

def _ex_eval(w):
    return EXAMPLES[w.example]

def _nc_dir_for_example(output_dir, cell_line):
    base = output_dir.replace("contrastive_explanation_", "non_contrastive_explanation_", 1)
    return f"{base}__{cell_line}"

os.makedirs(BIO_NET_DIR, exist_ok=True)
os.makedirs(PRETRAIN_DIR, exist_ok=True)
if USE_TRAIN:
    os.makedirs(TRAIN_DIR, exist_ok=True)
for _od in OUTPUT_DIRS:
    os.makedirs(os.path.join(CONTRASTIVE_ROOT, _od), exist_ok=True)
for _od in NC_OUTPUT_DIRS:
    os.makedirs(os.path.join(CONTRASTIVE_ROOT, _od), exist_ok=True)
if EVAL_EXAMPLES:
    os.makedirs(EVAL_DIR, exist_ok=True)

wildcard_constraints:
    output_dir = r"(?:non_)?contrastive_explanation_[^/]+",
    model      = r"model_[^/]+",
    example    = "(" + "|".join(re.escape(e) for e in EVAL_EXAMPLES) + ")" if EVAL_EXAMPLES else r".^",

# Model replicates: each model_k is trained on the same data with seed base_seed + k
MODELS = [f"model_{i}" for i in range(N_MODELS)]
print(f"Using {len(MODELS)} model replicates: {MODELS}")


