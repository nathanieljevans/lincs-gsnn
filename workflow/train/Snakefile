rule all:
    input:
        os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        SPLIT_PATH,
        # gene_norm artifact: unconditional input. BIOGSNN's log1p-back
        # degradation term requires it; make_bio_network.py writes it from
        # cfg['make_bio_network']['gene_stats'].
        GENE_NORM_PATH,
        # node_activity artifact: only required when enabled; otherwise the
        # list entry is empty and make_bio_network skips the build.
        ([NA_PATH] if USE_NA else []),
        expand(os.path.join(PRETRAIN_DIR, "pretrained_model_{model}.pt"), model=MODELS),
        # The hypernetwork artifact is only required when use_hypernetwork is
        # enabled in the config; otherwise this list is empty and pretrain_gsnn
        # produces just the legacy artifact.
        (expand(os.path.join(PRETRAIN_DIR, "pretrained_hnet_{model}.pt"), model=MODELS)
         if USE_HNET else []),
        # The odeint-fine-tuned model is only required when train.enabled=true.
        # In that case downstream explain rules also switch to consuming it.
        (expand(os.path.join(TRAIN_DIR, "trained_model_{model}.pt"), model=MODELS)
         if USE_TRAIN else []),
        expand(os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "aggregated_cres.csv"),
               output_dir=OUTPUT_DIRS),
        expand(os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "aggregated_cres.csv"),
               output_dir=NC_OUTPUT_DIRS),
        (expand(os.path.join(EVAL_DIR, "{example}.pt"), example=EVAL_EXAMPLES)
         if EVAL_EXAMPLES else []),
        ([os.path.join(EVAL_DIR, "eval_results.pt"),
          os.path.join(EVAL_DIR, "eval_results.json"),
          os.path.join(EVAL_DIR, "eval_results.csv"),
          os.path.join(EVAL_DIR, "config.yaml")]
         if EVAL_EXAMPLES else []),

rule all_eval:
    '''Run explanation evaluation and aggregate into a single run-level report.'''
    input:
        os.path.join(EVAL_DIR, "eval_results.pt"),
        os.path.join(EVAL_DIR, "eval_results.json"),
        os.path.join(EVAL_DIR, "eval_results.csv"),
        os.path.join(EVAL_DIR, "config.yaml"),

rule all_contrastive:
    '''Run contrastive explanation for all examples and all samples'''
    input:
        expand(os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "{model}",
                            "contrastive_results_{model}.csv"),
               output_dir=OUTPUT_DIRS, model=MODELS),

rule all_non_contrastive:
    '''Run non-contrastive explanation for all examples, all cell lines, all samples.'''
    input:
        expand(os.path.join(CONTRASTIVE_ROOT, "{output_dir}", "{model}",
                            "non_contrastive_results_{model}.csv"),
               output_dir=NC_OUTPUT_DIRS, model=MODELS),
