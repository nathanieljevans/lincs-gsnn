rule contrastive_explanation_trametinib_mapk_node_target:
    '''
    Contrastive explanation for Trametinib (MEK inhibitor) - MAPK-addicted vs MAPK-independent response.
    Compares MDAMB231 (RAS-mutant, MAPK-addicted) vs MCF7 (PIK3CA-mutant, MAPK-independent) cell lines.
    Target gene: DUSP6 (ERK-feedback regulator gene).
    Uses node-level explanation target instead of edge-level.
    '''
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        model = os.path.join(PRETRAIN_DIR, "pretrained_model_{sample}.pt"),
        scale = os.path.join(PRETRAIN_DIR, "dxdt_scale_{sample}.pt"),
    output:
        csv = os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_NODE_TARGET_DIR, "{sample}", "contrastive_results_{sample}.csv"),
        pt = os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_NODE_TARGET_DIR, "{sample}", "contrastive_results_{sample}.pt"),
    params:
        script = cfg['scripts']["contrastive_explanation"],
        root_gsnn = os.path.join(cfg['dirs']['runs'], RUN_ID),
        root_traj = cfg['dirs']["preds"].replace('/predict_grid', ''),
        out_dir = os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_NODE_TARGET_DIR, "{sample}"),
        target_gene = cfg['contrastive_explanation_trametinib_mapk_node_target']["target_gene"],
        cell_line_1 = cfg['contrastive_explanation_trametinib_mapk_node_target']["cell_line_1"],
        cell_line_2 = cfg['contrastive_explanation_trametinib_mapk_node_target']["cell_line_2"],
        pert_id = cfg['contrastive_explanation_trametinib_mapk_node_target']["pert_id"],
        dose = cfg['contrastive_explanation_trametinib_mapk_node_target']["dose"],
        horizon = cfg['contrastive_explanation_trametinib_mapk_node_target']["horizon"],
        n_time_pts = cfg['contrastive_explanation_trametinib_mapk_node_target']["n_time_pts"],
        method = cfg['contrastive_explanation_trametinib_mapk_node_target']["method"],
        tol = cfg['contrastive_explanation_trametinib_mapk_node_target']["tol"],
        hard = cfg['contrastive_explanation_trametinib_mapk_node_target']["hard"],
        beta = cfg['contrastive_explanation_trametinib_mapk_node_target']["beta"],
        lr = cfg['contrastive_explanation_trametinib_mapk_node_target']["lr"],
        prior = cfg['contrastive_explanation_trametinib_mapk_node_target']["prior"],
        iters = cfg['contrastive_explanation_trametinib_mapk_node_target']["iters"],
        entropy = cfg['contrastive_explanation_trametinib_mapk_node_target']["entropy"],
        grad_norm_clip = cfg['contrastive_explanation_trametinib_mapk_node_target']["grad_norm_clip"],
        free_edges = cfg['contrastive_explanation_trametinib_mapk_node_target']["free_edges"],
        explanation_target = cfg['contrastive_explanation_trametinib_mapk_node_target']["explanation_target"],
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --root_gsnn {params.root_gsnn} \
            --root_traj {params.root_traj} \
            --sample_id {wildcards.sample} \
            --target_gene {params.target_gene} \
            --cell_line_1 {params.cell_line_1} \
            --cell_line_2 {params.cell_line_2} \
            --pert_id {params.pert_id} \
            --dose {params.dose} \
            --horizon {params.horizon} \
            --n_time_pts {params.n_time_pts} \
            --method {params.method} \
            --tol {params.tol} \
            {params.hard} \
            --beta {params.beta} \
            --lr {params.lr} \
            --prior {params.prior} \
            --iters {params.iters} \
            --entropy {params.entropy} \
            --grad_norm_clip {params.grad_norm_clip} \
            --free_edges {params.free_edges} \
            --explanation_target {params.explanation_target} \
            --out {params.out_dir}
        """

