import os, datetime
import yaml 
import glob

# ------------------------------------------------------------------------------------
# ------------------------------------------------------------------------------------


configfile: "config.yaml"
cfg = config

RUN_ID  = cfg["run_id"]

BIO_NET_DIR = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['dirs']["bio_network"])
PRETRAIN_DIR = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['dirs']["pretrain"])
CONTRASTIVE_PALBOCICLIB_RB1_DIR = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['contrastive_explanation_palbociclib_rb1']["output_dir"])
CONTRASTIVE_TRAMETINIB_MAPK_DIR = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['contrastive_explanation_trametinib_mapk']["output_dir"])
CONTRASTIVE_TRAMETINIB_MAPK_NODE_TARGET_DIR = os.path.join(cfg['dirs']['runs'], RUN_ID, cfg['contrastive_explanation_trametinib_mapk_node_target']["output_dir"])

os.makedirs(BIO_NET_DIR, exist_ok=True)
os.makedirs(PRETRAIN_DIR, exist_ok=True)
os.makedirs(CONTRASTIVE_PALBOCICLIB_RB1_DIR, exist_ok=True)
os.makedirs(CONTRASTIVE_TRAMETINIB_MAPK_DIR, exist_ok=True)
os.makedirs(CONTRASTIVE_TRAMETINIB_MAPK_NODE_TARGET_DIR, exist_ok=True)

# Find all sample directories
PREDS_DIR = cfg['dirs']["preds"]
SAMPLES = [os.path.basename(p) for p in glob.glob(os.path.join(PREDS_DIR, "sample_*")) if os.path.isdir(p)]
print(f"Found samples: {SAMPLES}")


# ------------------------------------------------------------------------------------
# ------------------------------------------------------------------------------------
rule all:
    input:
        os.path.join(BIO_NET_DIR, f"bionetwork.pt"),
        expand(os.path.join(PRETRAIN_DIR, "pretrained_model_{sample}.pt"), sample=SAMPLES),
        os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "aggregated_cres.csv"),
        os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_DIR, "aggregated_cres.csv"),
        os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_NODE_TARGET_DIR, "aggregated_cres.csv"),

rule all_contrastive_palbociclib_rb1:
    '''Run contrastive explanation for Palbociclib/RB1 for all samples'''
    input:
        expand(os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "{sample}", "contrastive_results_{sample}.csv"), sample=SAMPLES),

rule all_contrastive_trametinib_mapk:
    '''Run contrastive explanation for Trametinib/MAPK for all samples'''
    input:
        expand(os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_DIR, "{sample}", "contrastive_results_{sample}.csv"), sample=SAMPLES),

rule all_contrastive_trametinib_mapk_node_target:
    '''Run contrastive explanation for Trametinib/MAPK (node target) for all samples'''
    input:
        expand(os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_NODE_TARGET_DIR, "{sample}", "contrastive_results_{sample}.csv"), sample=SAMPLES),
