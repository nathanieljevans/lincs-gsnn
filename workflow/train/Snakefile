rule make_bio_network:
    ''''''
    output:
        net = os.path.join(BIO_NET_DIR, f"bionetwork.pt")
    params:
        script = cfg['scripts']["make_bio_network"],
        data = cfg['dirs']["data"],
        extdata = cfg['dirs']["extdata"],
        meta = cfg['dirs']["preds"],
        out = BIO_NET_DIR,
        include_mirna = cfg['make_bio_network']["include_mirna"],
        include_extra = cfg['make_bio_network']["include_extra"],
        dorothea_levels = cfg['make_bio_network']["dorothea_levels"],
        max_dti_kd = cfg['make_bio_network']["max_dti_kd"],
        filter_depth = cfg['make_bio_network']["filter_depth"],
        remove_output_edges = cfg['make_bio_network']["remove_output_edges"],
        n_edges_to_remove = cfg['make_bio_network']["n_edges_to_remove"],
        seed = cfg['make_bio_network']["seed"],

    shell:
        """
        python {params.script} \
            --data {params.data} \
            --out  {params.out} \
            --extdata {params.extdata} \
            --meta {params.meta} \
            {params.include_mirna} \
            {params.include_extra} \
            --dorothea_levels {params.dorothea_levels} \
            --max_dti_kd {params.max_dti_kd} \
            --filter_depth {params.filter_depth} \
            {params.remove_output_edges} \
            --n_edges_to_remove {params.n_edges_to_remove} \
            --seed {params.seed}
        """

rule pretrain_gsnn:
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        sample_obs = os.path.join(cfg['dirs']["preds"], "{sample}", "obs"),
        sample_dxdt = os.path.join(cfg['dirs']["preds"], "{sample}", "dxdt"),
    output:
        model = os.path.join(PRETRAIN_DIR, "pretrained_model_{sample}.pt"),
        scale = os.path.join(PRETRAIN_DIR, "dxdt_scale_{sample}.pt"),
    params:
        script = cfg['scripts']["pretrain"],
        data = cfg['dirs']['preds'],
        out = PRETRAIN_DIR,
        batch_size = cfg['pretrain']["batch_size"],
        num_workers = cfg['pretrain']["num_workers"],
        epochs = cfg['pretrain']["epochs"],
        lr = cfg['pretrain']["lr"],
        wd = cfg['pretrain']["wd"],
        init = cfg['pretrain']["init"],
        patience = cfg['pretrain']["patience"],
        channels = cfg['pretrain']["channels"],
        layers = cfg['pretrain']["layers"],
        share_layers = cfg['pretrain']["share_layers"],
        dropout = cfg['pretrain']["dropout"],
        norm = cfg['pretrain']["norm"],
        checkpoint = cfg['pretrain']["checkpoint"],

    shell:
        """
        python {params.script} \
            --data {params.data} \
            --out {params.out} \
            --bionet $(dirname {input.bionet}) \
            --sample {wildcards.sample} \
            --batch_size {params.batch_size} \
            --num_workers {params.num_workers} \
            --epochs {params.epochs} \
            --lr {params.lr} \
            --wd {params.wd} \
            --init {params.init} \
            --patience {params.patience} \
            --channels {params.channels} \
            --layers {params.layers} \
            {params.share_layers} \
            --dropout {params.dropout} \
            --norm {params.norm} \
            {params.checkpoint}
        """

rule contrastive_explanation_palbociclib_rb1:
    '''
    Contrastive explanation for Palbociclib (CDK4/6 inhibitor) - RB1-dependent vs RB1-null response.
    Compares MCF7 (RB1-proficient) vs MDAMB468 (RB1-deficient) cell lines.
    Target gene: CCNE2 (E2F-regulated proliferation gene).
    '''
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        model = os.path.join(PRETRAIN_DIR, "pretrained_model_{sample}.pt"),
        scale = os.path.join(PRETRAIN_DIR, "dxdt_scale_{sample}.pt"),
    output:
        csv = os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "{sample}", "contrastive_results_{sample}.csv"),
        pt = os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "{sample}", "contrastive_results_{sample}.pt"),
    params:
        script = cfg['scripts']["contrastive_explanation"],
        root_gsnn = os.path.join(cfg['dirs']['runs'], RUN_ID),
        root_traj = cfg['dirs']["preds"].replace('/predict_grid', ''),
        out_dir = os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "{sample}"),
        target_gene = cfg['contrastive_explanation_palbociclib_rb1']["target_gene"],
        cell_line_1 = cfg['contrastive_explanation_palbociclib_rb1']["cell_line_1"],
        cell_line_2 = cfg['contrastive_explanation_palbociclib_rb1']["cell_line_2"],
        pert_id = cfg['contrastive_explanation_palbociclib_rb1']["pert_id"],
        dose = cfg['contrastive_explanation_palbociclib_rb1']["dose"],
        horizon = cfg['contrastive_explanation_palbociclib_rb1']["horizon"],
        n_time_pts = cfg['contrastive_explanation_palbociclib_rb1']["n_time_pts"],
        method = cfg['contrastive_explanation_palbociclib_rb1']["method"],
        tol = cfg['contrastive_explanation_palbociclib_rb1']["tol"],
        hard = cfg['contrastive_explanation_palbociclib_rb1']["hard"],
        beta = cfg['contrastive_explanation_palbociclib_rb1']["beta"],
        lr = cfg['contrastive_explanation_palbociclib_rb1']["lr"],
        prior = cfg['contrastive_explanation_palbociclib_rb1']["prior"],
        iters = cfg['contrastive_explanation_palbociclib_rb1']["iters"],
        entropy = cfg['contrastive_explanation_palbociclib_rb1']["entropy"],
        grad_norm_clip = cfg['contrastive_explanation_palbociclib_rb1']["grad_norm_clip"],
        free_edges = cfg['contrastive_explanation_palbociclib_rb1']["free_edges"],
        explanation_target = cfg['contrastive_explanation_palbociclib_rb1']["explanation_target"],
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --root_gsnn {params.root_gsnn} \
            --root_traj {params.root_traj} \
            --sample_id {wildcards.sample} \
            --target_gene {params.target_gene} \
            --cell_line_1 {params.cell_line_1} \
            --cell_line_2 {params.cell_line_2} \
            --pert_id {params.pert_id} \
            --dose {params.dose} \
            --horizon {params.horizon} \
            --n_time_pts {params.n_time_pts} \
            --method {params.method} \
            --tol {params.tol} \
            {params.hard} \
            --beta {params.beta} \
            --lr {params.lr} \
            --prior {params.prior} \
            --iters {params.iters} \
            --entropy {params.entropy} \
            --grad_norm_clip {params.grad_norm_clip} \
            --free_edges {params.free_edges} \
            --explanation_target {params.explanation_target} \
            --out {params.out_dir}
        """

rule aggregate_contrastive_palbociclib_rb1:
    '''
    Aggregate contrastive explanation results from all samples.
    Merges cres DataFrames (outer merge with sample suffix).
    Aggregates out_dicts into a single dictionary.
    '''
    input:
        csvs = expand(os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "{sample}", "contrastive_results_{sample}.csv"), sample=SAMPLES),
        pts = expand(os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "{sample}", "contrastive_results_{sample}.pt"), sample=SAMPLES),
    output:
        cres_csv = os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "aggregated_cres.csv"),
        out_dict = os.path.join(CONTRASTIVE_PALBOCICLIB_RB1_DIR, "aggregated_out_dict.pt"),
    params:
        script = cfg['scripts']["aggregate_contrastive"],
        input_dir = CONTRASTIVE_PALBOCICLIB_RB1_DIR,
        out_dir = CONTRASTIVE_PALBOCICLIB_RB1_DIR,
        name = "aggregated",
    shell:
        """
        python {params.script} \
            --input_dir {params.input_dir} \
            --out {params.out_dir} \
            --name {params.name}
        """

rule contrastive_explanation_trametinib_mapk:
    '''
    Contrastive explanation for Trametinib (MEK inhibitor) - MAPK-addicted vs MAPK-independent response.
    Compares MDAMB231 (RAS-mutant, MAPK-addicted) vs MCF7 (PIK3CA-mutant, MAPK-independent) cell lines.
    Target gene: DUSP6 (ERK-feedback regulator gene).
    '''
    input:
        bionet = os.path.join(BIO_NET_DIR, "bionetwork.pt"),
        model = os.path.join(PRETRAIN_DIR, "pretrained_model_{sample}.pt"),
        scale = os.path.join(PRETRAIN_DIR, "dxdt_scale_{sample}.pt"),
    output:
        csv = os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_DIR, "{sample}", "contrastive_results_{sample}.csv"),
        pt = os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_DIR, "{sample}", "contrastive_results_{sample}.pt"),
    params:
        script = cfg['scripts']["contrastive_explanation"],
        root_gsnn = os.path.join(cfg['dirs']['runs'], RUN_ID),
        root_traj = cfg['dirs']["preds"].replace('/predict_grid', ''),
        out_dir = os.path.join(CONTRASTIVE_TRAMETINIB_MAPK_DIR, "{sample}"),
        target_gene = cfg['contrastive_explanation_trametinib_mapk']["target_gene"],
        cell_line_1 = cfg['contrastive_explanation_trametinib_mapk']["cell_line_1"],
        cell_line_2 = cfg['contrastive_explanation_trametinib_mapk']["cell_line_2"],
        pert_id = cfg['contrastive_explanation_trametinib_mapk']["pert_id"],
        dose = cfg['contrastive_explanation_trametinib_mapk']["dose"],
        horizon = cfg['contrastive_explanation_trametinib_mapk']["horizon"],
        n_time_pts = cfg['contrastive_explanation_trametinib_mapk']["n_time_pts"],
        method = cfg['contrastive_explanation_trametinib_mapk']["method"],
        tol = cfg['contrastive_explanation_trametinib_mapk']["tol"],
        hard = cfg['contrastive_explanation_trametinib_mapk']["hard"],
        beta = cfg['contrastive_explanation_trametinib_mapk']["beta"],
        lr = cfg['contrastive_explanation_trametinib_mapk']["lr"],
        prior = cfg['contrastive_explanation_trametinib_mapk']["prior"],
        iters = cfg['contrastive_explanation_trametinib_mapk']["iters"],
        entropy = cfg['contrastive_explanation_trametinib_mapk']["entropy"],
        grad_norm_clip = cfg['contrastive_explanation_trametinib_mapk']["grad_norm_clip"],
        free_edges = cfg['contrastive_explanation_trametinib_mapk']["free_edges"],
        explanation_target = cfg['contrastive_explanation_trametinib_mapk']["explanation_target"],
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --root_gsnn {params.root_gsnn} \
            --root_traj {params.root_traj} \
            --sample_id {wildcards.sample} \
            --target_gene {params.target_gene} \
            --cell_line_1 {params.cell_line_1} \
            --cell_line_2 {params.cell_line_2} \
            --pert_id {params.pert_id} \
            --dose {params.dose} \
            --horizon {params.horizon} \
            --n_time_pts {params.n_time_pts} \
            --method {params.method} \
            --tol {params.tol} \
            {params.hard} \
            --beta {params.beta} \
            --lr {params.lr} \
            --prior {params.prior} \
            --iters {params.iters} \
            --entropy {params.entropy} \
            --grad_norm_clip {params.grad_norm_clip} \
            --free_edges {params.free_edges} \
            --explanation_target {params.explanation_target} \
            --out {params.out_dir}
        """

